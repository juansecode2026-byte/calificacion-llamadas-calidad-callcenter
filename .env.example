# Copiar a .env y completar con los valores reales.
# .env está en .gitignore -- .env.example (este archivo) SÍ se commitea,
# sin valores reales. Ver la sección "Variables de entorno" en CLAUDE.md.

# --- Frontend (frontend/dashboard) ---
# Prefijo VITE_ obligatorio para que Vite las empaquete. NUNCA poner acá
# un secreto -- todo lo que empieza con VITE_ es público en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (backend/functions, backend/worker) ---
# Bypassea RLS. Solo del lado del servidor, jamás con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Agente evaluador (backend/agent/client.ts) ---
# Solo del lado del servidor, jamás con prefijo VITE_.
ANTHROPIC_API_KEY=

# --- Worker de transcripción ---
# Ej: whisper-medium, faster-whisper. Ver docs/CONTEXT.md sección 6.
WHISPER_MODEL=
